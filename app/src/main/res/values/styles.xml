<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BotonPrimario" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/morado</item>
        <item name="android:textColor">@color/texto</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/morado</item>
        <item name="hintTextColor">@color/morado</item>
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="CampoLista" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/morado</item>
        <item name="hintTextColor">@color/morado</item>
        <item name="boxBackgroundColor">@color/superficie</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>