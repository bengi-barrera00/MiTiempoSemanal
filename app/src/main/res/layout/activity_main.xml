<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/app_name"
        android:textColor="@color/texto" android:textSize="32sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvAutorVersion"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/morado"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="@string/subtitulo"
        android:textColor="@color/texto_suave" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCategorias"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/superficie" app:cardCornerRadius="20dp"
        app:cardElevation="0dp" app:strokeColor="@color/borde" app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/categorias" android:textColor="@color/texto"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/categorias_desc"
                android:textColor="@color/texto_suave" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTareas"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/superficie" app:cardCornerRadius="20dp"
        app:cardElevation="0dp" app:strokeColor="@color/borde" app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/tareas" android:textColor="@color/texto"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/tareas_desc"
                android:textColor="@color/texto_suave" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEventos"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/superficie" app:cardCornerRadius="20dp"
        app:cardElevation="0dp" app:strokeColor="@color/borde" app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/eventos" android:textColor="@color/texto"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/eventos_desc"
                android:textColor="@color/texto_suave" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>