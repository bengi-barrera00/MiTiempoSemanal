<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/superficie" app:cardCornerRadius="16dp"
    app:cardElevation="0dp" app:strokeColor="@color/borde" app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/texto" android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/texto_suave" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>